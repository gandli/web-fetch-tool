# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
# Public base URL used to build archive/back links. Leave empty for localhost.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Database
#   pglite -> zero-setup embedded Postgres (default, local development)
#   pg     -> real Postgres via DATABASE_URL (docker compose up -d db)
# ---------------------------------------------------------------------------
DB_DRIVER=pglite
PGLITE_PATH=.data/pglite
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/web_fetch

# ---------------------------------------------------------------------------
# API auth
#   API_AUTH_REQUIRED=true -> /api/fetch, /api/ai, /api/archive need a token.
#   Tokens are created with: bun run token:create -- --name dev --scopes fetch,ai
# ---------------------------------------------------------------------------
API_AUTH_REQUIRED=true
# Optional overrides for per-token / per-IP / per-chat limits.
API_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_PER_HOUR=300
HISTORY_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Fetch limits (free-first chain: self -> Jina -> paid adapters)
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_MS=15000
MAX_HTML_BYTES=8388608
MAX_CONTENT_CHARS=60000
JINA_BASE_URL=https://r.jina.ai
# Optional: raise GitHub REST anonymous quota (60 req/h) by setting a PAT.
GITHUB_TOKEN=
# Optional: real Trafilatura precision extractor (Python sidecar, see services/extractor).
TRAFILATURA_URL=
# GitHub intro fallback (DeepWiki-style). Disabled by default: upstream rate limits hard.
DEEPWIKI_ENABLED=false

# ---------------------------------------------------------------------------
# AI (OpenRouter). Free models first; quality mode is paid and optional.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FREE=google/gemma-4-31b-it:free
OPENROUTER_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,thinkingmachines/inkling:free
OPENROUTER_MODEL_QUALITY=

# ---------------------------------------------------------------------------
# Archive channels
# ---------------------------------------------------------------------------
TELEGRAPH_ENABLED=true
ARCHIVE_DEFAULT_CHANNELS=telegraph
# Optional paid/unused-in-this-milestone adapters (kept for later wiring).
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
GITHUB_ARCHIVE_TOKEN=
GITHUB_ARCHIVE_REPO=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Telegram bot
#   TELEGRAM_BIND_CODE: required for /bind <code>; set a random string >= 8 chars.
#   TELEGRAM_ALLOWED_CHAT_IDS: optional comma separated chat id allowlist.
#   TELEGRAM_API_BASE: override for local fake Bot API in tests.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BIND_CODE=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_RATE_LIMIT_PER_MINUTE=5
TELEGRAM_RATE_LIMIT_PER_HOUR=40

# ---------------------------------------------------------------------------
# Secrets at rest (platform sessions). 32-byte value: openssl rand -hex 32
# ---------------------------------------------------------------------------
SERVER_ENCRYPTION_KEY=
